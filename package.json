{
  "name": "gds",
  "version": "0.1.0",
  "private": true,
  "description": "GDS — 그린카 디자인 시스템 Foundation. 원본 .fig 실측 기반 정적 사이트.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "extract": "node --max-old-space-size=8192 tools/figdec/foundation.js",
    "extract:radius": "node --max-old-space-size=8192 tools/figdec/r3_impact.js",
    "extract:census": "node --max-old-space-size=8192 tools/figdec/census_radius.js",
    "build": "node build/site.js",
    "check": "node build/check.js",
    "all": "npm run build && npm run check",
    "fetch:rest": "node tools/figapi/fetch.js",
    "compare": "node tools/figapi/compare.js",
    "canon": "node --max-old-space-size=8192 tools/figdec/canon.js"
  },
  "dependencies": {},
  "devDependencies": {}
}